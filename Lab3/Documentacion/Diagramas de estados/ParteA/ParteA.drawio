        <mxCell id="wZpxxwBawcxlNqIlNWka-53" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;b&gt;Fallo de lectura&lt;/b&gt;" vertex="1">
